# Pulse — environment variables
# Copy to .env and fill in values. Never commit .env.

# ── Codex (onchain token data) ──────────────────────────────────────────────
CODEX_API_KEY=

# ── CDP Embedded Wallet (required for wallet connect) ───────────────────────
# Get your project ID from https://portal.cdp.coinbase.com
# Allowlist your app domain in Embedded Wallet Configuration
VITE_CDP_PROJECT_ID=

# ── WalletConnect (optional, deprecated — CDP embedded wallet is primary) ─────
VITE_WALLETCONNECT_PROJECT_ID=

# ── Relay (cross-chain bridge / trade routing) ────────────────────────────────
RELAY_API_KEY=

# ── Hyperliquid ────────────────────────────────────────────────────────────────
# Optional overrides (leave blank to use SDK defaults).
VITE_HYPERLIQUID_API_URL=
VITE_HYPERLIQUID_WS_URL=

# ── API origin restriction (optional) ───────────────────────────────────────────
# When set, /api/* only accepts requests from this origin (e.g. https://pulse.vercel.app).
# Skipped in development or when unset.
PULSE_PROD_URL=
