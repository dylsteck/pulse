# Codex (onchain token data)
CODEX_API_KEY=

# CDP (Coinbase Developer Platform)
# Get your project ID from https://portal.cdp.coinbase.com
# Allowlist your app domain (eg. http://localhost:3000) in Embedded Wallet Configuration
VITE_CDP_PROJECT_ID=

# Hyperliquid (optional)
# Optional overrides (leave blank to use SDK defaults)
VITE_HYPERLIQUID_API_URL=
VITE_HYPERLIQUID_WS_URL=
