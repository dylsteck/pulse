# Base JSON-RPC (optional) — spanDEX quotes/simulation; use an RPC that supports eth_simulateV1 if simulation fails
# VITE_BASE_RPC_URL=

# Optional aggregator keys for spanDEX (only if you add matching providers in src/lib/evm/spandex-config.ts)
# VITE_ZEROX_API_KEY=

# Codex (onchain token data)
# Workers: `bunx wrangler secret put CODEX_API_KEY`
# Node/Docker/Coolify: set as an env var
CODEX_API_KEY=

# Optional: restrict /api/* to this origin in production (Node/Docker).
# On Workers this is set in wrangler.jsonc.
# PULSE_PROD_URL=https://pulse.dylansteck.com

# CDP (Coinbase Developer Platform)
# Get your project ID from https://portal.cdp.coinbase.com
# Allowlist your app domain (eg. http://localhost:3000) in Embedded Wallet Configuration
VITE_CDP_PROJECT_ID=

# Hyperliquid (optional)
# Optional overrides (leave blank to use SDK defaults)
VITE_HYPERLIQUID_API_URL=
VITE_HYPERLIQUID_WS_URL=
