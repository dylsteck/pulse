# Pulse — environment variables
# Copy to .env and fill in values. Never commit .env.

# ── Codex (onchain token data) ──────────────────────────────────────────────
CODEX_API_KEY=

# ── WalletConnect (optional) ──────────────────────────────────────────────────
# Optional: enables WalletConnect connector
VITE_WALLETCONNECT_PROJECT_ID=

# ── Relay (cross-chain bridge / trade routing) ────────────────────────────────
RELAY_API_KEY=

# ── Hyperliquid ────────────────────────────────────────────────────────────────
# Optional overrides (leave blank to use SDK defaults).
VITE_HYPERLIQUID_API_URL=
VITE_HYPERLIQUID_WS_URL=
