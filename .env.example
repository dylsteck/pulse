# Pulse — environment variables
# Copy to .env and fill in values. Never commit .env.

# ── Codex (onchain token data) ──────────────────────────────────────────────
CODEX_API_KEY=

# ── CDP (Coinbase Developer Platform) embedded wallet ────────────────────────
CDP_PROJECT_ID=
CDP_API_KEY_NAME=
CDP_API_KEY_PRIVATE_KEY=

# ── Relay (cross-chain bridge / trade routing) ────────────────────────────────
RELAY_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
# Set to "true" to use live API data instead of mock data (post-MVP)
VITE_USE_LIVE_DATA=false
