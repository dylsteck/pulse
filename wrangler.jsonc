{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pulse",
  "account_id": "b6c3bd7b1a1c219a306faf2c3f0a903a",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [{ "pattern": "pulse.dylansteck.com", "custom_domain": true }],
  "vars": {
    "PULSE_PROD_URL": "https://pulse.dylansteck.com",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
